# Copy this file to backend/.env and fill in.
# SEC asks every automated client to identify itself with contact details.
QUANTX_USER_AGENT="QuantX personal research your-email@example.com"

# Optional, free: https://www.tiingo.com (Account -> API). Enables stock price history.
QUANTX_TIINGO_API_KEY=

# Local database (default). For PostgreSQL/TimescaleDB later:
# QUANTX_DATABASE_URL=postgresql+psycopg://quantx:change-me@localhost:5432/quantx  (also: pip install psycopg[binary])
# QUANTX_DATABASE_URL=sqlite:///./data/quantx.db
